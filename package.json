{
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "lefthook install || true",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "knip": "knip",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "turbo build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "turbo": "^2.11.4",
    "typescript": "7.0.2",
    "ultracite": "7.12.0"
  },
  "overrides": {
    "rolldown-plugin-dts": {
      "typescript": "$typescript"
    },
    "tsdown": {
      "typescript": "$typescript"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.0.1"
}
